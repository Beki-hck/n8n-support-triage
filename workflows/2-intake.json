      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, route: $json.route, category: $json.category, urgency: $json.urgency, lang: $json.lang, message: $json.lang === 'am' ? 'መልእክትዎ ደርሶናል። በቅርቡ እንመልስልዎታለን።' : 'Thanks, we got your message and will reply soon.' }) }}",
        "options": {}
