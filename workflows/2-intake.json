    {
      "id": "36f67e24-af07-d00e-45e7-b2e165e8dfe8",
      "name": "Write Telegram texts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        460
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Telegram reads these messages as Markdown, so a _ * ` or [ in a customer's\n// message would make Telegram reject it. Escape them, and write every\n// Telegram text in one place.\nconst esc = (s) => String(s ?? '').replace(/([_*`\\[])/g, '\\\\$1');\nconst j = $json;\nlet ownerText;\nif (j.route === 'urgent' && j.channel === 'telegram')\n  ownerText = '🔴 URGENT (' + esc(j.category) + ') from ' + esc(j.from) + ':\\n\"' + esc(j.text) + '\"\\n\\nAI draft reply:\\n\"' + esc(j.reply_draft) + '\"\\n\\nSend this reply to the customer?';\nelse if (j.route === 'urgent')   // website: the bot has no way to answer, so the owner replies\n  ownerText = '🔴 URGENT (' + esc(j.category) + ') from ' + esc(j.from) + ' via the website:\\n\"' + esc(j.text) + '\"\\n\\nSummary: ' + esc(j.summary) + '\\nThe bot can\\'t reply on the website. Please contact this customer yourself.';\nelse ownerText = '🟡 Needs you (' + esc(j.problem || j.category) + ') from ' + esc(j.from) + ' via ' + j.channel + ':\\n\"' + esc(j.text) + '\"\\n\\nSummary: ' + esc(j.summary);\nconst ack = j.lang === 'am'\n  ? 'ሰላም! መልእክትዎ ደርሶናል። በቅርቡ እንመልስልዎታለን። 🙏'\n  : 'Hi! We got your message and will reply soon. 🙏';\nreturn { json: { ...j, tg_owner_text: ownerText, tg_customer_reply: esc(j.reply_draft), tg_ack: ack } };\n"
      }
    },
